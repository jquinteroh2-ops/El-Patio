# Copie este archivo a local/.env y rellene los dos secretos.
#
#   cp local/.env.ejemplo local/.env
#
# local/.env NO se sube al repositorio: lleva las claves de esta instalación.

# Clave de la base. Invéntela larga; nadie la teclea nunca, solo la lee el
# backend por la red interna de Docker.
DATABASE_CLAVE=

# Firma de los tokens de sesión. Mínimo 32 caracteres. Genérela así:
#
#   openssl rand -base64 48
#
# Si la cambia, todas las sesiones abiertas se cierran.
ELPATIO_JWT_SECRETO=

# --- Lo de abajo casi nunca hay que tocarlo ---

# Puerto por el que entran las tablets. 80 es el normal: se escribe la IP sola,
# sin dos puntos ni número. Cámbielo solo si algo más ya lo ocupa en el equipo.
# PUERTO=80

# DATABASE_NOMBRE=elpatio
# DATABASE_USUARIO=elpatio

# Zona horaria del día operativo y del turno.
# ELPATIO_ZONA=America/Bogota

# Desde qué direcciones se aceptan las tablets. Por defecto cubre las redes
# privadas normales de un local. Solo se toca si la red usa otro rango.
# ELPATIO_CORS_ORIGENES=http://192.168.*.*,http://192.168.*.*:*
