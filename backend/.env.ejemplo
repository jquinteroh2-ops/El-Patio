# Copie este archivo a .env y ajuste los valores. El .env real NO se versiona.
#
# En Railway estas mismas variables se definen en el panel del servicio; aquí
# solo están los valores de la máquina de desarrollo.

# Base de datos. El 5433 es el puerto del contenedor de docker-compose.yml.
DATABASE_URL=jdbc:postgresql://localhost:5433/elpatio
DATABASE_USUARIO=elpatio
DATABASE_CLAVE=elpatio

# Firma de los tokens. Mínimo 32 caracteres: con menos, el backend no arranca.
# Genere uno propio para cada entorno, por ejemplo con:
#   openssl rand -base64 48
ELPATIO_JWT_SECRETO=cambie-este-secreto-por-uno-aleatorio-de-al-menos-32-caracteres

# Orígenes autorizados, separados por comas. Nunca `*`.
ELPATIO_CORS_ORIGENES=http://localhost:5173

# Zona en la que se calculan el día operativo y el turno.
ELPATIO_ZONA=America/Bogota

# --- Integraciones (todas opcionales: vacías = la función queda inactiva) ---

# WhatsApp Cloud API. El PHONE_NUMBER_ID y el token salen de
# developers.facebook.com -> la app -> Casos de uso -> Conectar en WhatsApp.
# El VERIFY_TOKEN lo inventa usted: es el que se le repite a Meta al suscribir
# el webhook. El APP_SECRET está en Configuración de la app -> Básica.
ELPATIO_WHATSAPP_URL_BASE=https://graph.facebook.com/v21.0
ELPATIO_WHATSAPP_PHONE_NUMBER_ID=
ELPATIO_WHATSAPP_TOKEN_ACCESO=
ELPATIO_WHATSAPP_VERIFY_TOKEN=
ELPATIO_WHATSAPP_APP_SECRET=

# Anticipos con Wompi. Vacío = sandbox sin llaves reales.
ELPATIO_WOMPI_URL_BASE=https://sandbox.wompi.co/v1
ELPATIO_WOMPI_LLAVE_PRIVADA=
ELPATIO_WOMPI_SECRETO_EVENTOS=

# Intérprete de pedidos con IA. Sin llave, el bot solo entiende los botones.
ELPATIO_ANTHROPIC_LLAVE=
ELPATIO_ANTHROPIC_MODELO=claude-opus-5
