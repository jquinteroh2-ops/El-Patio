# Copie este archivo a .env.local para desarrollo. El .env real no se versiona.
#
# Solo las variables que empiezan por VITE_ llegan al navegador, y todas quedan
# escritas en el paquete compilado: aquí nunca va un secreto.

# URL del API, sin barra final.
VITE_URL_API=http://localhost:8080

# URL del WebSocket. Si se omite, se deduce de la del API cambiando el esquema
# (http->ws, https->wss), que es lo correcto en casi todos los despliegues.
# VITE_URL_WS=ws://localhost:8080/ws

# Si El Patio emite documentos fiscales por su cuenta.
#
# Apagada, y asi debe quedarse mientras Globalsoft sea el sistema que factura:
# dos sistemas emitiendo contra el mismo NIT es peor que ninguno. El Patio cobra
# y entrega comprobante interno; el documento fiscal lo emite el ERP.
#
# Solo se pone en 'true' si el restaurante decide volver a facturar desde aqui,
# y entonces hay que llenar ademas la resolucion en src/compartido/config.ts.
VITE_FACTURACION_INTERNA_HABILITADA=false

# URL del sistema de La Carreta, el otro restaurante del dueno. Sin barra final.
#
# Es lo unico que ata los dos proyectos. Con esto puesto, el panel
# administrativo pinta arriba un selector que lleva al panel de La Carreta, a la
# misma seccion en la que se este. Sin esto, el selector no aparece.
#
# En desarrollo se deja comentada: casi nunca estan los dos sistemas levantados
# a la vez, y un boton que lleva a una direccion muerta es peor que no tenerlo.
# En Railway se pone el dominio real del frontend de La Carreta.
# VITE_URL_HERMANO=https://lacarreta.up.railway.app
